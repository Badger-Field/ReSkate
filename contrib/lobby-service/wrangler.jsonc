{
  // ReSkate lobby service. Deploy: npx wrangler login, then npx wrangler deploy.
  "name": "reskate-lobby",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // One public address: the custom domain skate.ops.rodeo, added in the dashboard, where
  // Cloudflare's firewall rules screen requests before they reach (and count against) the
  // Worker. No workers.dev URL and no per-version preview URLs: those skip the firewall.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // SQLite-backed Durable Objects are on Cloudflare's free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
  // Production also needs a secret for join challenges: npx wrangler secret put CHALLENGE_SECRET
}
